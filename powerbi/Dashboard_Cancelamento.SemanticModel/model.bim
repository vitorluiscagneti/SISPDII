          },
          {
            "name": "Alunos Alto Risco",
            "expression": "CALCULATE(COUNTROWS('vw_PowerBI_Previsao'), 'vw_PowerBI_Previsao'[FaixaRisco] = \"Alto\")",
            "formatString": "#,0",
            "lineageTag": "95a95858-22f7-489e-93f7-d2560037a9bf"
          },
          {
            "name": "Previstos Cancelar",
            "expression": "SUM('vw_PowerBI_Previsao'[Previsao])",
            "formatString": "#,0",
            "lineageTag": "4d14f64e-b3c9-41bc-bac0-6c3736899d43"
          },
          {
            "name": "Acuracia Modelo",
            "expression": "AVERAGEX('vw_PowerBI_Previsao', IF('vw_PowerBI_Previsao'[Previsao] = 'vw_PowerBI_Previsao'[CancelouReal], 1, 0))",
            "formatString": "0.0%",
            "lineageTag": "2c57fc2d-3643-4a8c-b0dd-2134edfdbcc0"
          },
